rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasRole(projectId, roles) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/memberships/$(projectId + '_' + request.auth.uid)).data.role in roles;
    }

    match /projects/{projectId}/references/{referenceId}/{fileId} {
      allow read: if hasRole(projectId, ['owner', 'editor', 'viewer', 'commenter']);
      allow create, update: if hasRole(projectId, ['owner', 'editor'])
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if hasRole(projectId, ['owner', 'editor']);
    }
  }
}
