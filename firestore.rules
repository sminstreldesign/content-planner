rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function signedIn() {
      return authenticated() && request.auth.token.email_verified == true;
    }
    function member(projectId) {
      return get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.auth.uid));
    }
    function hasRole(projectId, roles) {
      return signedIn() && member(projectId).data.role in roles;
    }
    function isOwner(projectId) { return hasRole(projectId, ['owner']); }
    function createdProjectOwner(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    function validAssignee(projectId) {
      return request.resource.data.keys().hasAll(['assigneeId', 'assigneeName'])
        && request.resource.data.assigneeId is string
        && request.resource.data.assigneeId.size() <= 128
        && request.resource.data.assigneeName is string
        && request.resource.data.assigneeName.size() <= 120
        && (
          (request.resource.data.assigneeId == '' && request.resource.data.assigneeName == '')
          || (request.resource.data.assigneeId != ''
            && exists(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId))
            && get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId)).data.projectId == projectId
            && get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId)).data.userId == request.resource.data.assigneeId)
        );
    }

    match /profiles/{userId} {
      allow create: if authenticated() && request.auth.uid == userId;
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      // commenter is a legacy value with viewer-only access until the owner opens the access screen.
      allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
      allow update, delete: if isOwner(projectId);

      match /networks/{networkId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.keys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow update: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /rubrics/{rubricId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create, update, delete: if hasRole(projectId, ['owner','editor']);
      }
      match /posts/{postId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.keys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow update: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /postImages/{imageId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasOnly(['postId', 'kind', 'dataUrl', 'authorId', 'createdAt'])
          && request.resource.data.postId is string
          && request.resource.data.kind in ['reference', 'visual']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 140000
          && request.resource.data.dataUrl.matches('^data:image/webp;base64,.*')
          && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /comments/{commentId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor']) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isOwner(projectId);
      }
      match /activity/{activityId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create, update: if false;
        allow delete: if isOwner(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletingAt'])
          && get(/databases/$(database)/documents/projects/$(projectId)).data.deletingAt is timestamp;
      }
    }
    match /invitations/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isOwner(request.resource.data.projectId);
      allow update: if signedIn() && isOwner(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if signedIn() && isOwner(resource.data.projectId);
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || hasRole(resource.data.projectId, ['owner','editor'])
      );
      allow create: if signedIn() && (
        (request.resource.data.userId == request.auth.uid &&
         get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.active == true &&
         get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.projectId == request.resource.data.projectId &&
         request.resource.data.role == 'viewer')
        || isOwner(request.resource.data.projectId)
        || (request.resource.data.userId == request.auth.uid && createdProjectOwner(request.resource.data.projectId))
      ) && (
        !request.resource.data.keys().hasAny(['specialty'])
        || (request.resource.data.specialty is string && request.resource.data.specialty.size() <= 100)
      );
      allow update: if signedIn()
        && isOwner(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'specialty'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['specialty'])
          || (request.resource.data.specialty is string && request.resource.data.specialty.size() <= 100)
        )
        && (
          (resource.data.role == 'owner' && request.resource.data.role == 'owner')
          || (resource.data.role != 'owner' && request.resource.data.role in ['viewer', 'editor'])
        );
      allow delete: if signedIn() && (
        (isOwner(resource.data.projectId) && resource.data.role != 'owner')
        || (resource.data.role == 'owner'
          && resource.data.userId == request.auth.uid
          && !exists(/databases/$(database)/documents/projects/$(resource.data.projectId)))
      );
    }
  }
}
