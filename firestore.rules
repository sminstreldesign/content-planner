rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(projectId) {
      return get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.auth.uid));
    }
    function hasRole(projectId, roles) {
      return signedIn() && member(projectId).data.role in roles;
    }
    function isOwner(projectId) { return hasRole(projectId, ['owner']); }
    function createdProjectOwner(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    function validAssignee(projectId) {
      return request.resource.data.keys().hasAll(['assigneeId', 'assigneeName'])
        && request.resource.data.assigneeId is string
        && request.resource.data.assigneeId.size() <= 128
        && request.resource.data.assigneeName is string
        && request.resource.data.assigneeName.size() <= 120
        && (
          (request.resource.data.assigneeId == '' && request.resource.data.assigneeName == '')
          || (request.resource.data.assigneeId != ''
            && exists(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId))
            && get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId)).data.projectId == projectId
            && get(/databases/$(database)/documents/memberships/$(projectId + '_' + request.resource.data.assigneeId)).data.userId == request.resource.data.assigneeId)
        );
    }

    match /profiles/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      // commenter is a legacy value with viewer-only access until the owner opens the access screen.
      allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
      allow update, delete: if isOwner(projectId);

      match /networks/{networkId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.keys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow update: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /rubrics/{rubricId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create, update, delete: if hasRole(projectId, ['owner','editor']);
      }
      match /posts/{postId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.keys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow update: if hasRole(projectId, ['owner','editor'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeName']) || validAssignee(projectId));
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /postImages/{imageId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasOnly(['postId', 'kind', 'dataUrl', 'authorId', 'createdAt'])
          && request.resource.data.postId is string
          && request.resource.data.kind in ['reference', 'visual']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 140000
          && request.resource.data.dataUrl.matches('^data:image/webp;base64,.*')
          && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /references/{referenceId} {
        function validMediaItem(item) {
          return item is map
            && item.keys().hasAll(['path', 'url', 'name', 'type', 'size'])
            && item.keys().hasOnly(['path', 'url', 'name', 'type', 'size'])
            && item.path is string
            && item.path.matches('^projects/' + projectId + '/references/' + referenceId + '/[^/]+$')
            && item.url is string && item.url.size() <= 2000
            && item.name is string && item.name.size() <= 180
            && item.type is string && item.type.matches('^(image|video)/.*')
            && item.size is int && item.size >= 0 && item.size <= 52428800;
        }
        function validMediaList() {
          return request.resource.data.media is list
            && request.resource.data.media.size() <= 4
            && (request.resource.data.media.size() < 1 || validMediaItem(request.resource.data.media[0]))
            && (request.resource.data.media.size() < 2 || validMediaItem(request.resource.data.media[1]))
            && (request.resource.data.media.size() < 3 || validMediaItem(request.resource.data.media[2]))
            && (request.resource.data.media.size() < 4 || validMediaItem(request.resource.data.media[3]));
        }
        function validReference() {
          return request.resource.data.networkId is string
            && request.resource.data.networkId.size() <= 128
            && exists(/databases/$(database)/documents/projects/$(projectId)/networks/$(request.resource.data.networkId))
            && request.resource.data.networkName is string
            && request.resource.data.networkName.size() <= 120
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 4000
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp
            && validMediaList();
        }
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasAll(['networkId', 'networkName', 'note', 'media', 'authorId', 'createdAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['networkId', 'networkName', 'note', 'media', 'authorId', 'createdAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && validReference();
        allow update: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['networkId', 'networkName', 'note', 'media', 'updatedBy', 'updatedAt'])
          && validReference();
        allow delete: if hasRole(projectId, ['owner','editor']);
      }
      match /comments/{commentId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor']) && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isOwner(projectId);
      }
      match /competitorAnalyses/{analysisId} {
        function validAnalysis() {
          return request.resource.data.companies is list
            && request.resource.data.companies.size() >= 2
            && request.resource.data.companies.size() <= 6
            && request.resource.data.criteria is list
            && request.resource.data.criteria.size() >= 1
            && request.resource.data.criteria.size() <= 12
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp;
        }
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if analysisId == 'main'
          && hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasAll(['companies', 'criteria', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['companies', 'criteria', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt is timestamp
          && validAnalysis();
        allow update: if analysisId == 'main'
          && hasRole(projectId, ['owner','editor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companies', 'criteria', 'updatedBy', 'updatedAt'])
          && validAnalysis();
        allow delete: if isOwner(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletingAt'])
          && get(/databases/$(database)/documents/projects/$(projectId)).data.deletingAt is timestamp;
      }
      match /audienceAnalyses/{analysisId} {
        function validAnalysis() {
          return request.resource.data.segments is list
            && request.resource.data.segments.size() >= 1
            && request.resource.data.segments.size() <= 8
            && request.resource.data.criteria is list
            && request.resource.data.criteria.size() >= 1
            && request.resource.data.criteria.size() <= 40
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp;
        }
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if analysisId == 'main'
          && hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasAll(['segments', 'criteria', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['segments', 'criteria', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt is timestamp
          && validAnalysis();
        allow update: if analysisId == 'main'
          && hasRole(projectId, ['owner','editor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['segments', 'criteria', 'updatedBy', 'updatedAt'])
          && validAnalysis();
        allow delete: if isOwner(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletingAt'])
          && get(/databases/$(database)/documents/projects/$(projectId)).data.deletingAt is timestamp;
      }
      match /projectDocuments/{documentId} {
        function validDocument() {
          return documentId in ['audit', 'notebook']
            && request.resource.data.kind == documentId
            && request.resource.data.chapters is list
            && request.resource.data.chapters.size() >= 1
            && request.resource.data.chapters.size() <= 30
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is timestamp;
        }
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.keys().hasAll(['kind', 'chapters', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['kind', 'chapters', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.createdAt is timestamp
          && validDocument();
        allow update: if hasRole(projectId, ['owner','editor'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chapters', 'updatedBy', 'updatedAt'])
          && validDocument();
        allow delete: if isOwner(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletingAt'])
          && get(/databases/$(database)/documents/projects/$(projectId)).data.deletingAt is timestamp;
      }
      match /activity/{activityId} {
        allow read: if hasRole(projectId, ['owner','editor','viewer','commenter']);
        allow create, update: if false;
        allow delete: if isOwner(projectId)
          && get(/databases/$(database)/documents/projects/$(projectId)).data.keys().hasAny(['deletingAt'])
          && get(/databases/$(database)/documents/projects/$(projectId)).data.deletingAt is timestamp;
      }
    }
    match /invitations/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isOwner(request.resource.data.projectId);
      allow update: if signedIn() && isOwner(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if signedIn() && isOwner(resource.data.projectId);
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || hasRole(resource.data.projectId, ['owner','editor'])
      );
      allow create: if signedIn() && (
        (request.resource.data.userId == request.auth.uid &&
         get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.active == true &&
         get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.projectId == request.resource.data.projectId &&
         request.resource.data.role == 'viewer')
        || isOwner(request.resource.data.projectId)
        || (request.resource.data.userId == request.auth.uid && createdProjectOwner(request.resource.data.projectId))
      ) && (
        !request.resource.data.keys().hasAny(['specialty'])
        || (request.resource.data.specialty is string && request.resource.data.specialty.size() <= 100)
      );
      allow update: if signedIn()
        && isOwner(resource.data.projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'specialty'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['specialty'])
          || (request.resource.data.specialty is string && request.resource.data.specialty.size() <= 100)
        )
        && (
          (resource.data.role == 'owner' && request.resource.data.role == 'owner')
          || (resource.data.role != 'owner' && request.resource.data.role in ['viewer', 'editor'])
        );
      allow delete: if signedIn() && (
        (isOwner(resource.data.projectId) && resource.data.role != 'owner')
        || (resource.data.role == 'owner'
          && resource.data.userId == request.auth.uid
          && !exists(/databases/$(database)/documents/projects/$(resource.data.projectId)))
      );
    }
  }
}
